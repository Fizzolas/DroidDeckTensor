--- a/hybris/vulkan/icd/swapchain.c
+++ b/hybris/vulkan/icd/swapchain.c
@@ -672,19 +672,29 @@ VkResult hybris_icd_prepare_device(VkPhysicalDevice physical, PFN_vkGetInstanceP
     *swapchain_enabled = 0;
 #ifdef WANT_WAYLAND
     uint32_t count = info->enabledExtensionCount;
-    const char **kept = malloc(((size_t)count + 1) * sizeof(*kept));
+    const char **kept = malloc(((size_t)count + 2) * sizeof(*kept));
     if (!kept) return VK_ERROR_OUT_OF_HOST_MEMORY;
     uint32_t kept_count = 0;
     int anb = 0;
