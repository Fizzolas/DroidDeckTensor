 #endif
-    uint32_t total = hal_count + (extra ? 1u : 0u);
+    static const VkExtensionProperties map_mem2_ext = {"VK_KHR_map_memory2", 1};
+    static const VkExtensionProperties map_placed_ext = {"VK_EXT_map_memory_placed", 1};
+    uint32_t extra_placed = 2u;
+    uint32_t total = hal_count + (extra ? 1u : 0u) + extra_placed;
     if (!properties) {
         *count = total;
         return VK_SUCCESS;
@@ -758,6 +771,8 @@ VkResult hybris_icd_enumerate_device_extensions(VkPhysicalDevice physical, const
 #ifdef WANT_WAYLAND
     if (extra && written < space) properties[written++] = swapchain;
 #endif
+    if (written < space) properties[written++] = map_mem2_ext;
+    if (written < space) properties[written++] = map_placed_ext;
     *count = written;
     return written < total ? VK_INCOMPLETE : VK_SUCCESS;
 }
